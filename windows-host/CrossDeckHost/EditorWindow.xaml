<Window x:Class="CrossDeckHost.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CrossDeckHost.Controls"
        Title="CrossDeck" Height="800" Width="1320" MinHeight="480" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" Background="Transparent"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- Custom chrome with native resize/snap/shadow -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="1" CornerRadius="10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#111118" Offset="0"/>
                <GradientStop Color="#0B0B0F" Offset="0.35"/>
                <GradientStop Color="#0B0B0F" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Margin="16,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                    <TextBlock Text="CROSSDECK" Foreground="{StaticResource Brush.Paper}" FontWeight="Bold"
                               FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock.LayoutTransform>
                            <ScaleTransform/>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                    <TextBlock Text="PROFILE EDITOR" Foreground="{StaticResource Brush.Mist}" FontSize="{StaticResource FontSize.Caption}"
                               Margin="10,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="—" Click="MinimizeButton_Click"/>
                    <Button Style="{StaticResource CaptionButton}" Content="✕" Click="CloseButton_Click" Margin="2,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Main Split Content Area -->
            <Grid Grid.Row="1" Margin="10,4,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="300" MinWidth="260" MaxWidth="460"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: PROFILE LIST -->
                <Grid Grid.Column="0" Margin="0,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="PROFILES" Foreground="{StaticResource Brush.Mist}" FontSize="{StaticResource FontSize.Caption}"
                               FontWeight="Bold" Margin="4,0,0,6"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ProfileListContainer"/>
                    </ScrollViewer>

                    <!-- Status footer: connection chip (expands pairing details on click) + settings gear -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ConnectionChip" Grid.Column="0" Padding="6,5" Background="{StaticResource Brush.Panel}"
                                BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="1" CornerRadius="8" Cursor="Hand"
                                MouseLeftButtonUp="ConnectionChip_Click">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="{StaticResource Brush.Alarm}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="DeviceNameText" Text="Offline" Foreground="{StaticResource Brush.Paper}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Button Grid.Column="1" x:Name="SettingsGearButton" Style="{StaticResource CaptionButton}" Content="⚙️" FontSize="14"
                                Margin="6,0,0,0" Click="SettingsGearButton_Click" ToolTip="Settings"/>
                    </Grid>

                    <!-- Pairing detail flyout, anchored to the connection chip — same content the old
                         sidebar card always showed, now shown on demand via Popup instead of taking
                         permanent vertical space. -->
                    <Popup x:Name="PairingPopup" Placement="Top"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Padding="12,10" Background="#14141B" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="1"
                                CornerRadius="12" Width="220" Margin="0,0,0,8">
                            <StackPanel x:Name="PairingPanel">
                                <Border Background="White" CornerRadius="8" Padding="6" HorizontalAlignment="Center">
                                    <Image x:Name="QrImage" Width="120" Height="120" Stretch="Uniform"/>
                                </Border>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ADDRESS" Foreground="{StaticResource Brush.Mist}" FontSize="{StaticResource FontSize.Caption}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PairingAddressText" Grid.Column="1" Foreground="{DynamicResource Brush.Accent}" FontSize="12"
                                               FontFamily="Cascadia Mono, Consolas" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="PIN" Foreground="{StaticResource Brush.Mist}" FontSize="{StaticResource FontSize.Caption}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PairingPinText" Grid.Column="1" Foreground="{StaticResource Brush.VoltViolet}" FontSize="16" FontWeight="Bold"
                                               FontFamily="Cascadia Mono, Consolas" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SECURITY CODE" Foreground="{StaticResource Brush.Mist}" FontSize="{StaticResource FontSize.Caption}" FontWeight="Bold" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="PairingFingerprintText" Grid.Column="1" Foreground="{DynamicResource Brush.Accent}" FontSize="9"
                                               FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" MaxWidth="145" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="Scan the QR in the phone app, or enter the address + PIN. Verify the security code first. Same WiFi required."
                                           Foreground="{StaticResource Brush.Mist}" FontSize="{StaticResource FontSize.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <Button x:Name="RegeneratePinButton" Style="{StaticResource StandardButton}" Content="🔄 New PIN" Click="RegeneratePinButton_Click" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- RIGHT MAIN GRID AREA -->
                <Border Grid.Column="1" Background="#0E0E14" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="1" CornerRadius="14" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Nav & Info Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BackButton" Style="{StaticResource StandardButton}" Content="◀ Go Back" VerticalAlignment="Center" Click="BackButton_Click" Visibility="Collapsed" Margin="0,0,10,0"/>
                            <StackPanel x:Name="BreadcrumbPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Trigger:" Foreground="{StaticResource Brush.Mist}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TriggerProcessTxt" Width="120" MinWidth="120" VerticalAlignment="Center" LostFocus="TriggerProcessTxt_LostFocus" KeyDown="TriggerProcessTxt_KeyDown" TextChanged="TriggerProcessTxt_TextChanged" ToolTip="e.g. chrome.exe (auto-switches to this profile)"/>
                            </StackPanel>
                        </Grid>

                        <!-- Grid Canvas -->
                        <Grid Grid.Row="1">
                            <ScrollViewer x:Name="ButtonGridScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <!-- Cells never shrink below a floor (set in code-behind, same
                                     fit-then-scroll rule Android's grid already uses) — once
                                     content no longer fits at a comfortable size, this scrolls
                                     instead of squeezing every button smaller. -->
                                <UniformGrid x:Name="ButtonGrid" Rows="3" Columns="5" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            </ScrollViewer>

                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16">
                                <Border x:Name="ToastNotificationCard" CornerRadius="10" Background="{StaticResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1" Padding="12,8" Margin="0,0,0,6" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="ToastStateDot" Width="8" Height="8" Fill="{StaticResource Brush.Alarm}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="ToastMessageText" Text="Device Disconnected" Foreground="{StaticResource Brush.Paper}" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="UndoToastCard" CornerRadius="10" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.VoltViolet}" BorderThickness="1" Padding="10,6" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="↩" Foreground="{StaticResource Brush.VoltViolet}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="UndoToastLabel" Text="Undo last edit" Foreground="{StaticResource Brush.Paper}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button x:Name="UndoBtn" Content="Undo" Click="UndoBtn_Click" Padding="8,3" FontSize="{StaticResource FontSize.Caption}" Background="{StaticResource Brush.VoltViolet}" Foreground="{StaticResource Brush.Paper}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Dial Strip — dial row pinned under the grid. Collapsed via
                             code-behind (RebuildDialRow) when the active profile has no dials. -->
                        <Border x:Name="DialStripBorder" Grid.Row="2" Margin="0,8,0,0" Padding="0,8,0,0"
                                BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,1,0,0" Visibility="Collapsed">
                            <UniformGrid x:Name="DialRow" Rows="1" HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="2" Width="8" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

                <!-- RIGHT: PROPERTY PANEL -->
                <Border Grid.Column="3" Background="#0E0E14" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="1" CornerRadius="14" Padding="10">
                    <controls:ButtonPropertyPanel x:Name="PropertyPanel"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
