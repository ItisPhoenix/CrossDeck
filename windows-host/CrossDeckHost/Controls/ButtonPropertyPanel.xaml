<UserControl x:Class="CrossDeckHost.Controls.ButtonPropertyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CrossDeckHost.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Empty state: nothing selected -->
        <TextBlock x:Name="EmptyStateText" Grid.Row="0" Grid.RowSpan="2"
                   Text="Select a button or dial to edit it"
                   Foreground="{StaticResource Brush.Mist}" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" Margin="20"/>

        <!-- Header: live preview chip + delete -->
        <Grid x:Name="HeaderRow" Grid.Row="0" Margin="0,0,0,14" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource Brush.Void}"
                    BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="1">
                <Image x:Name="PreviewIcon" Stretch="Uniform" Margin="5"/>
            </Border>
            <TextBlock x:Name="PreviewLabel" Grid.Column="1" Text="Button" FontWeight="SemiBold" FontSize="13"
                       Foreground="{StaticResource Brush.Paper}" VerticalAlignment="Center" Margin="10,0,0,0"
                       TextTrimming="CharacterEllipsis"/>
            <Button x:Name="DeleteIconBtn" Grid.Column="2" Style="{StaticResource CaptionButton}"
                    Content="🗑" FontSize="13" Click="DeleteIconBtn_Click" ToolTip="Delete this button"/>
        </Grid>

        <ScrollViewer x:Name="ContentScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Label" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Brush.Paper}" Margin="0,0,0,6"/>
                <TextBox x:Name="LabelInput" Margin="0,0,0,16" Padding="10,8" FontSize="13" TextChanged="LabelInput_TextChanged"
                         ToolTip="Text shown on the button in both apps"/>

                <StackPanel x:Name="MainIconSection">
                    <TextBlock Text="Icon" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Brush.Paper}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="IconPathText" Padding="10,8" FontSize="12" IsReadOnly="True" Margin="0,0,6,0"
                                 ToolTip="Current icon reference — read-only, use Browse or Built-in to change it"/>
                        <Button Grid.Column="1" Style="{StaticResource StandardButton}" Padding="10,8" Margin="0,0,6,0"
                                Click="BrowseIcon_Click" Content="📂" ToolTip="Upload a custom image from this PC"/>
                        <Button Grid.Column="2" x:Name="BuiltinIconBtn" Style="{StaticResource StandardButton}" Padding="10,8"
                                Click="ToggleBuiltinIcons_Click" Content="🎨" ToolTip="Choose from CrossDeck's bundled icon set"/>
                    </Grid>
                    <Border x:Name="BuiltinIconsDrawer" Background="{StaticResource Brush.Void}" BorderBrush="{StaticResource Brush.Hairline}"
                            BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,16" Visibility="Collapsed">
                        <StackPanel>
                            <TextBox x:Name="IconSearchInput" Padding="8,6" FontSize="12" Margin="0,0,0,8" Background="{StaticResource Brush.Panel}"
                                     TextChanged="IconSearchInput_TextChanged" ToolTip="Filter the built-in icons by name"/>
                            <ScrollViewer Height="130" VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="IconWrapPanel" Orientation="Horizontal"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Text="Action Type" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Brush.Paper}" Margin="0,0,0,6"/>
                <controls:ActionConfigControl x:Name="MainActionConfig" Margin="0,0,0,16"/>

                <Border Height="1" Background="{StaticResource Brush.Hairline}" Margin="0,0,0,16"/>

                <TextBlock x:Name="MultiActionLongPressNote"
                           Text="Tapping this button runs every step above, in order, with any delays you've set."
                           Foreground="{StaticResource Brush.Mist}" FontSize="11" Margin="0,0,0,16" TextWrapping="Wrap" Visibility="Collapsed"/>

                <StackPanel x:Name="LongPressSection">
                    <TextBlock Text="Tap Action" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Brush.Paper}" Margin="0,0,0,4"/>
                    <TextBlock Text="Fires when this dial is tapped (dragging it adjusts the level). Same options as the main action above."
                               Foreground="{StaticResource Brush.Mist}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <CheckBox x:Name="LongPressEnabledCheck" Content="Enable tap action" FontSize="12" Margin="0,0,0,10"
                              Checked="LongPressEnabledCheck_Changed" Unchecked="LongPressEnabledCheck_Changed"/>
                    <Border x:Name="LongPressButton1Card" Visibility="Collapsed" Background="{StaticResource Brush.Void}"
                            BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="LongPressButton1Header" Text="Tap Action 1" FontWeight="Bold" FontSize="11"
                                       Foreground="{StaticResource Brush.Mist}" Margin="0,0,0,8"/>
                            <controls:ActionConfigControl x:Name="LongPressActionConfig"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="AddAnotherLongPressActionButton" Content="+ Add Another Action" Style="{StaticResource StandardButton}"
                            Margin="0,0,0,16" HorizontalAlignment="Left" Click="AddAnotherLongPressAction_Click"/>
                </StackPanel>

                <TextBlock x:Name="ValidationHintText" Foreground="{StaticResource Brush.Alarm}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
